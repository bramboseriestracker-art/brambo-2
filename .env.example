# Copy to .env for local development. Never commit .env.
# In production (Vercel) set the same names under Project Settings > Environment Variables.

# --- Required ---
# MongoDB Atlas (or local) connection string, including the database name
MONGODB_URI=mongodb://127.0.0.1:27017/brambo
# 48+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# TMDB v3 API key or v4 read access token (server side only)
TMDB_API_KEY=

# --- Admin account (created or updated by: npm run db:setup) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeThisStrongPassword1

# --- Email (verification codes and password reset) ---
# Any SMTP provider. Example for Gmail with an App Password: smtp.gmail.com / 465 / your address / the 16-character app password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Brambo <your-address@gmail.com>"
# Without SMTP settings (development only) the code is printed in the API console instead of being emailed.

# --- Optional ---
# Set to "off" to skip the DNS check that an email domain can receive mail (offline development, automated tests)
# EMAIL_MX_CHECK=off
